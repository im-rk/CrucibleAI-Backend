# Copy this file to .env for local development. Every key is optional: without one the
# pipeline still runs, in a degraded mode that the UI and every report state explicitly.

# --- Keys ---------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Free key from next.materialsproject.org; without it only a small offline reference table is used
MATERIALS_PROJECT_API_KEY=

# --- Models & agents ------------------------------------------------------------------------
# anthropic | gemini | groq | auto (auto: the first of Anthropic, Gemini, Groq whose key is set)
LLM_PROVIDER=auto
ANTHROPIC_MODEL=claude-sonnet-4-6
# Google Gemini (aistudio.google.com). The free tier allows only ~20 requests/day per model and a
# research run uses about 10, so expect 1-2 runs per day per model on the free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Groq (console.groq.com). Free tier: about 1000 requests/day but only ~8000 tokens/minute, so keep
# LLM_CONCURRENCY low (2) to avoid per-minute limits.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
RELEVANCE_THRESHOLD=0.65
MAX_RETRIES=3
MIN_RELEVANT_CHUNKS=5
LIVE_ARXIV_FALLBACK=true
LLM_CONCURRENCY=4
# Cache model answers locally (on | off | refresh). Saves quota, makes evaluations repeatable, replays reruns instantly.
LLM_CACHE=on
LLM_CACHE_PATH=.cache/llm_cache.sqlite
LLM_CACHE_TTL_S=604800
# Provider tokens-per-minute cap to schedule around (0 = off). Groq free tier: 8000; set a little lower, e.g. 7000.
LLM_TOKENS_PER_MINUTE=0
# Most real (non-cached) model calls one research run may make
LLM_MAX_CALLS_PER_RUN=60

# --- Retrieval ------------------------------------------------------------------------------
# Weight of the keyword (BM25) list when fusing it with semantic search; 2 beat equal weights on every benchmark task
BM25_WEIGHT=2.0
RERANKER_ENABLED=false
# Set to false only on networks that intercept TLS and break arXiv PDF downloads
ARXIV_VERIFY_SSL=true
# Verify HTTPS against the OS certificate store (fixes CERTIFICATE_VERIFY_FAILED behind TLS-inspecting
# proxies/antivirus without turning verification off)
USE_SYSTEM_CERTS=true

# --- Vector store -----------------------------------------------------------------------------
# chroma (embedded, default) or pinecone (production; pip install pinecone, then
# python scripts/migrate_to_pinecone.py). With Pinecone the pipeline is semantic-only (no BM25)
# and /api/papers is unavailable.
VECTOR_STORE=chroma
PINECONE_API_KEY=
PINECONE_INDEX=crucible-papers
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- PostgreSQL (audit trail; best-effort, the API works without it) -------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=matsci_agent
PERSISTENCE_ENABLED=true

# --- API runtime ------------------------------------------------------------------------------
# Origins allowed to call the API from a browser (comma-separated). No credentials are sent.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# A run on a rate-limited free tier can take several minutes; raise this if runs time out
PIPELINE_TIMEOUT_S=300
MAX_CONCURRENT_RUNS=2
LOG_LEVEL=INFO

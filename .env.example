# Copy this file to .env for local development.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=matsci_agent
CHROMA_HOST=localhost
CHROMA_PORT=8000
ANTHROPIC_API_KEY=
# Free key from next.materialsproject.org; without it only a small offline reference table is used
MATERIALS_PROJECT_API_KEY=

# LLM agents (without a key the pipeline still runs in a degraded heuristic mode and says so)
ANTHROPIC_MODEL=claude-sonnet-4-6
RELEVANCE_THRESHOLD=0.65
MAX_RETRIES=3
MIN_RELEVANT_CHUNKS=5
LIVE_ARXIV_FALLBACK=true

# Retrieval
RERANKER_ENABLED=false
# Set to false only on networks that intercept TLS and break arXiv PDF downloads
ARXIV_VERIFY_SSL=true

# API runtime
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PIPELINE_TIMEOUT_S=300
MAX_CONCURRENT_RUNS=2
LOG_LEVEL=INFO

# Copy this file to .env for local development. Every key is optional: without one the
# pipeline still runs, in a degraded mode that the UI and every report state explicitly.

# --- Keys ---------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Free key from next.materialsproject.org; without it only a small offline reference table is used
MATERIALS_PROJECT_API_KEY=

# --- Models & agents ------------------------------------------------------------------------
ANTHROPIC_MODEL=claude-sonnet-4-6
RELEVANCE_THRESHOLD=0.65
MAX_RETRIES=3
MIN_RELEVANT_CHUNKS=5
LIVE_ARXIV_FALLBACK=true
LLM_CONCURRENCY=4

# --- Retrieval ------------------------------------------------------------------------------
RERANKER_ENABLED=false
# Set to false only on networks that intercept TLS and break arXiv PDF downloads
ARXIV_VERIFY_SSL=true
# Verify HTTPS against the OS certificate store (fixes CERTIFICATE_VERIFY_FAILED behind TLS-inspecting
# proxies/antivirus without turning verification off)
USE_SYSTEM_CERTS=true

# --- Vector store -----------------------------------------------------------------------------
# chroma (embedded, default) or pinecone (production; pip install pinecone, then
# python scripts/migrate_to_pinecone.py). With Pinecone the pipeline is semantic-only (no BM25)
# and /api/papers is unavailable.
VECTOR_STORE=chroma
PINECONE_API_KEY=
PINECONE_INDEX=crucible-papers
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- PostgreSQL (audit trail; best-effort, the API works without it) -------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=matsci_agent
PERSISTENCE_ENABLED=true

# --- API runtime ------------------------------------------------------------------------------
# Origins allowed to call the API from a browser (comma-separated). No credentials are sent.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PIPELINE_TIMEOUT_S=300
MAX_CONCURRENT_RUNS=2
LOG_LEVEL=INFO
